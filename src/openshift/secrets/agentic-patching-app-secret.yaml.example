# Application credentials — apply via apply-secrets.sh from openshift/.env.openshift
apiVersion: v1
kind: Secret
metadata:
  name: agentic-patching-app-secret
type: Opaque
stringData:
  LIGHTSPEED_CLIENT_ID: "REPLACE_ME"
  LIGHTSPEED_CLIENT_SECRET: "REPLACE_ME"
  GIT_HUB_TOKEN: "REPLACE_ME"
  AAP_TOKEN: "REPLACE_ME"
  AAP_BASE_URL: "https://aap-example.apps.example.com/api/controller/v2"
