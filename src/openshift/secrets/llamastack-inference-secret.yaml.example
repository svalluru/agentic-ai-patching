# Inference model — apply via apply-secrets.sh from openshift/.env.openshift
apiVersion: v1
kind: Secret
metadata:
  name: llama-stack-inference-model-secret
type: Opaque
stringData:
  INFERENCE_MODEL: llama-17b/llama-scout-17b
  VLLM_URL: https://maas-example.apps.example.com/v1
  VLLM_TLS_VERIFY: "false"
  VLLM_API_TOKEN: "REPLACE_ME"
