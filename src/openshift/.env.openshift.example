# Copy to openshift/.env.openshift and fill in values (do not commit .env.openshift).
# Shell format: KEY=value  (NOT YAML "KEY: value")
# Used by: ./openshift/scripts/setup-openshift.sh

NAMESPACE=agentic-patching

# --- Remote Ansible AAP (same controller across clusters) ---
AAP_BASE_URL=https://aap-example.apps.example.com/api/controller/v2
AAP_TOKEN=
AAP_DEFAULT_PROJECT_ID=43
AAP_DEFAULT_INVENTORY_ID=1
AAP_DEFAULT_EXECUTION_ENVIRONMENT_ID=2
AAP_DEFAULT_ORGANIZATION_ID=1
AAP_VERIFY_TLS=false

# --- Insights (Lightspeed service account) ---
LIGHTSPEED_CLIENT_ID=
LIGHTSPEED_CLIENT_SECRET=

# --- GitHub ---
GIT_HUB_TOKEN=

# --- Inference (KServe in-cluster or external MaaS) ---
INFERENCE_MODEL=llama-17b/llama-scout-17b
VLLM_URL=https://maas-example.apps.example.com/v1
VLLM_API_TOKEN=
VLLM_TLS_VERIFY=false

# --- Optional: Milvus / Postgres (defaults shown in openshift/secrets/*.yaml.example) ---
# POSTGRES_PASSWORD=changeme
# MILVUS_ROOT_PASSWORD=changeme

# --- Optional: skip long steps ---
# SKIP_BUILD=false
# SKIP_RAG_INGEST=false
# LLAMA_STACK_URL=
